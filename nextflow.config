params {
    input        = null
    outdir       = 'results'

    model        = 'gemma4'
    think        = true
    review       = false
    review_passes = 2
    whole_report = false
    synthesis    = true
    prompt       = null
    num_ctx      = 32768
    temperature  = null
    seed         = null
    top_p        = null
    top_k        = null
    num_predict  = null
}


profiles {
    docker {
        docker.enabled = true
    }
    native {
        docker.enabled = false
    }
    igs {
        apptainer {
            enabled = true
            autoMounts = true
            pullTimeout = '60m'
        }
        params {
            slurm_account = null
        }
        process {
            executor = 'slurm'
            clusterOptions = {
                account ? "-A ${params.slurm_account?.toString()?.trim()}" : ''
            }
            errorStrategy =  'retry'
            maxRetries = 3
            withLabel: 'process_gpu' {
                // Allocate a gpu
                clusterOptions = "--gres=gpu:1 -A ${params.slurm_account?.toString()?.trim()}"
                // Enable Nvidia in apptainer
                containerOptions = "--nv"
            
            // Allocate matching CPU/RAM to feed the GPU
            cpus = 2
            memory = '32 GB'
            time = '4h'
            }
        }
    }
}

report {
    enabled   = true
    file      = "data/nextflow_logs/report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "data/nextflow_logs/timeline.html"
    overwrite = true
}

